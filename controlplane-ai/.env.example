DEMO_MODE=true
PORT=8000
FRONTEND_URL=http://localhost:5173
# Set to true only to wipe the audit-log DB on startup (local demo reset).
# Leave false/unset in any persistent or production-like environment.
RESET_DB_ON_START=false

# Set DEMO_MODE=false and provide one of these to route node_llm and the
# AI-as-Judge detector through a real hosted model via LiteLLM instead of
# the canned mock provider. Leave both unset to stay in Demo Mode.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override which real model each internal routing tier maps to
# (defaults to gpt-4o-mini / gpt-4o). See backend/app/providers/litellm_provider.py.
# FAST_MODEL=gpt-4o-mini
# SMART_MODEL=gpt-4o
# SECURE_MODEL=gpt-4o-mini

# LangGraph checkpointer (paused HITL reviews + per-thread state).
# sqlite (default) persists to CHECKPOINT_DB_PATH so a server restart doesn't
# orphan a pending review. Set to "memory" to opt back into MemorySaver
# (lost on restart) — the test suite always forces "memory" regardless of
# this setting, via backend/tests/conftest.py.
# CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_DB_PATH=langgraph_state.db
