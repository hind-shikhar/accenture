DEMO_MODE=false
PORT=8000
FRONTEND_URL=http://localhost:5173
# Set to true only to wipe the audit-log DB on startup (local demo reset).
# Leave false/unset in any persistent or production-like environment.
RESET_DB_ON_START=false


# Set DEMO_MODE=false and provide one of these to route node_llm and the
# AI-as-Judge detector through a real hosted model via LiteLLM instead of
# the canned mock provider. Leave both unset to stay in Demo Mode.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override which real model each internal routing tier maps to
# (defaults to gpt-4o-mini / gpt-4o). See backend/app/providers/litellm_provider.py.
# FAST_MODEL=gpt-4o-mini
# SMART_MODEL=gpt-4o
# SECURE_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# ^ Deliberately defaults to a different model than SMART_MODEL: the
# AI-as-Judge detector must not grade the same model's own generation output.
# If you set this to the same value as SMART_MODEL, the judge's evidence will
# carry self_graded=true whenever the router picks the smart tier for
# generation (see backend/app/evaluation/ai_judge.py).

# LangGraph checkpointer (paused HITL reviews + per-thread state).
# sqlite (default) persists to CHECKPOINT_DB_PATH so a server restart doesn't
# orphan a pending review. Set to "postgres" (+ CHECKPOINT_DB_URL) for a
# multi-instance deployment — SQLite-file state can't be shared across
# replicas. Requires the optional langgraph-checkpoint-postgres + asyncpg
# packages (requirements-optional.txt). Set to "memory" to opt back into
# MemorySaver (lost on restart) — the test suite always forces "memory"
# regardless of this setting, via backend/tests/conftest.py.
# CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_DB_PATH=langgraph_state.db
# CHECKPOINT_DB_URL=postgresql://user:pass@host:5432/controlplane

# Audit log / threshold recommendation storage. sqlite (default) is a local
# file; point this at Postgres for a real deployment (requires the optional
# psycopg2-binary + asyncpg packages). backend/app/db/database.py picks an
# async-capable driver automatically for request-time queries.
# DATABASE_URL=postgresql://user:pass@host:5432/controlplane

# Session / HITL-escalation state (backend/app/session/context.py). Unset
# keeps the in-process dict (lost on restart, not shareable across
# replicas). Set this to back it with Redis instead — required for any
# multi-instance deployment. Requires the optional redis package.
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL_SECONDS=86400

# Observability (backend/app/config/observability.py). Enabled by default —
# instruments FastAPI with OpenTelemetry and starts a Prometheus metrics
# server. Traces print to the console by default; set
# OTEL_EXPORTER_OTLP_ENDPOINT to export to a real collector instead
# (requires the optional opentelemetry-exporter-otlp-proto-grpc package).
# ENABLE_OBSERVABILITY=true
# PROMETHEUS_PORT=9090
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
